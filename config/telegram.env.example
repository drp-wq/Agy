# Separate Telegram bot configuration for /root/multi-exchange-paper-audit-fixes
# Copy to config/telegram.env (chmod 600) and fill in a dedicated bot token & chat ID
# (or set TELEGRAM_ENV_PATH / TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID in the environment).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DASHBOARD_URL=http://127.0.0.1:8789
TELEGRAM_MINIAPP_URL=http://127.0.0.1:8789/miniapp
